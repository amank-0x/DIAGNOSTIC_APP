# ==============================================================================
# B.L. DIAGNOSTIC CENTER — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# SECURITY NOTICE:
# - NEVER commit real secrets, private keys, SMS API keys, OTP secrets, or passwords to Git.
# - Copy this file to `.env` (or `.env.development`, `.env.staging`, `.env.production`).
# - Client-exposed variables MUST be prefixed with `VITE_`.
# - Backend-only credentials (SMS_API_KEY, OTP_SECRET, DATABASE_URL, GOOGLE_PRIVATE_KEY)
#   MUST NOT use the `VITE_` prefix so they are never bundled into browser assets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME ENVIRONMENT & APPLICATION SERVER
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,https://www.bldiagnostic.com"

# ------------------------------------------------------------------------------
# 2. MOBILE NUMBER + OTP AUTHENTICATION & SMS GATEWAY (BACKEND-ONLY)
# ------------------------------------------------------------------------------
# Supported SMS_PROVIDER values: MSG91 | FAST2SMS | TWILIO
SMS_PROVIDER="MSG91"
SMS_API_KEY=""
SMS_SENDER_ID="BLDIAG"
SMS_TEMPLATE_ID=""

# Optional Twilio SMS credentials (if SMS_PROVIDER="TWILIO")
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# OTP Security & Session Configuration (Backend-only — never expose to browser)
OTP_SECRET="replace-with-64-char-cryptographic-random-otp-hmac-secret"
SESSION_SECRET="replace-with-64-char-cryptographic-random-session-secret"
OTP_EXPIRY_SECONDS="300"
OTP_RESEND_COOLDOWN_SECONDS="30"
OTP_MAX_ATTEMPTS="5"
OTP_RATE_LIMIT_WINDOW_MS="600000"
OTP_MAX_SENDS_PER_WINDOW="6"
ADMIN_MOBILE_NUMBERS="+919649183422"

# ------------------------------------------------------------------------------
# 3. FIREBASE / FIRESTORE CONFIGURATION (PUBLIC CLIENT CONFIG)
# ------------------------------------------------------------------------------
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id-placeholder"
VITE_FIREBASE_APP_ID="your-firebase-app-id-placeholder"
VITE_FIREBASE_API_KEY="your-firebase-web-api-key-placeholder"
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-project-id.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="your-firebase-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id-placeholder"

# ------------------------------------------------------------------------------
# 4. GOOGLE MAPS PLATFORM CONFIGURATION
# ------------------------------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY="your-google-maps-api-key-placeholder"

# ------------------------------------------------------------------------------
# 5. GOOGLE SHEETS DATABASE INTEGRATION (BACKEND-ONLY — NEVER EXPOSE TO BROWSER)
# ------------------------------------------------------------------------------
GOOGLE_PROJECT_ID="your-gcp-project-id-placeholder"
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

GOOGLE_SHEETS_SYNC_ENABLED="true"
GOOGLE_SHEETS_MAX_RETRY_ATTEMPTS="5"
GOOGLE_SHEETS_RETRY_BACKOFF_MS="3000"

# ------------------------------------------------------------------------------
# 6. PRIMARY DATABASE CONFIGURATION (POSTGRESQL / PRISMA)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD_PLACEHOLDER@localhost:5432/bl_diagnostic_dev?schema=public"
DIRECT_URL="postgresql://DB_USER:DB_PASSWORD_PLACEHOLDER@localhost:5432/bl_diagnostic_dev?schema=public"

# ------------------------------------------------------------------------------
# 7. API RATE LIMITING, REPORT STORAGE & LOGGING
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="120"
REPORT_STORAGE_PROVIDER="private_encrypted_store"
REPORT_STORAGE_BUCKET="bl-diagnostic-private-reports-prod"
REPORT_MAX_FILE_SIZE_MB="10"
REPORT_SIGNED_URL_EXPIRY_SECONDS="900"
LOG_LEVEL="info"
ENABLE_AUDIT_LOGGING="true"
BACKUP_RETENTION_DAYS="30"
